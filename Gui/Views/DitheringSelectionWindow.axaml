<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Gui.ViewModels"
	mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
	x:Class="Gui.Views.DitheringSelectionWindow"
	x:DataType="vm:DitheringSelectionWindowViewModel"
	Title="Select Dithering Method"
	WindowStartupLocation="CenterOwner"
	WindowDecorations="Full"
	Width="320"
	Height="220"
	ShowInTaskbar="False">

	<Design.DataContext>
		<vm:DitheringSelectionWindowViewModel/>
	</Design.DataContext>

	<DockPanel Margin="12">
		<StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
			<Button Command="{Binding ConfirmCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinWidth="80">OK</Button>
			<Button Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinWidth="80">Cancel</Button>
		</StackPanel>

		<StackPanel Spacing="8">
			<TextBlock Text="Choose a dithering algorithm for palette image conversion:" TextWrapping="Wrap" />
			<ComboBox SelectedItem="{Binding SelectedMethod}"
					ItemsSource="{x:Static vm:DitheringMethods.WithoutNone}"
					HorizontalAlignment="Stretch" />
			<CheckBox IsChecked="{Binding SetAsDefault}" Content="Set as default (skip this popup next time)" />
		</StackPanel>
	</DockPanel>
</Window>

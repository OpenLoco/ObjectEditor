@page "/"
@model ObjectService.Pages.IndexModel
@{
	ViewData["Title"] = "Object Explorer";
}

@section HeaderContent {
	<div class="site-header-stat">
		<span>Total objects</span>
		<strong>@Model.Results.TotalCount</strong>
	</div>
}

<section id="theme-studio-panel" class="panel theme-studio" data-theme-studio hidden>
	<div class="theme-studio-header">
		<div>
			<p class="eyebrow">Theme Studio</p>
			<h2>Trial an eight-colour palette</h2>
			<p class="lede">Paste or pick eight hex colours and the page will derive the rest of the theme tokens automatically. The palette is stored only in this browser and follows the light/dark toggle.</p>
		</div>
	</div>
	<form class="theme-palette-form" data-theme-palette-form>
		<div class="theme-palette-grid">
			<label class="field palette-field">
				<span>Accent</span>
				<div class="palette-input-row">
					<input type="color" value="#F6C945" data-palette-picker="accent" aria-label="Accent colour picker" />
					<input type="text" value="#F6C945" maxlength="7" spellcheck="false" autocomplete="off" data-palette-input="accent" aria-label="Accent hex colour" />
				</div>
				<div class="variant-swatches" data-variant-swatches="accent" aria-label="Accent brightness variants"></div>
			</label>
			<label class="field palette-field">
				<span>Surface</span>
				<div class="palette-input-row">
					<input type="color" value="#D9D9D6" data-palette-picker="surface" aria-label="Surface colour picker" />
					<input type="text" value="#D9D9D6" maxlength="7" spellcheck="false" autocomplete="off" data-palette-input="surface" aria-label="Surface hex colour" />
				</div>
				<div class="variant-swatches" data-variant-swatches="surface" aria-label="Surface brightness variants"></div>
			</label>
			<label class="field palette-field">
				<span>Muted</span>
				<div class="palette-input-row">
					<input type="color" value="#8A8D8F" data-palette-picker="muted" aria-label="Muted colour picker" />
					<input type="text" value="#8A8D8F" maxlength="7" spellcheck="false" autocomplete="off" data-palette-input="muted" aria-label="Muted hex colour" />
				</div>
				<div class="variant-swatches" data-variant-swatches="muted" aria-label="Muted brightness variants"></div>
			</label>
			<label class="field palette-field">
				<span>Background</span>
				<div class="palette-input-row">
					<input type="color" value="#2E2F33" data-palette-picker="background" aria-label="Background colour picker" />
					<input type="text" value="#2E2F33" maxlength="7" spellcheck="false" autocomplete="off" data-palette-input="background" aria-label="Background hex colour" />
				</div>
				<div class="variant-swatches" data-variant-swatches="background" aria-label="Background brightness variants"></div>
			</label>
			<label class="field palette-field">
				<span>Contrast</span>
				<div class="palette-input-row">
					<input type="color" value="#FFF6E0" data-palette-picker="contrast" aria-label="Contrast colour picker" />
					<input type="text" value="#FFF6E0" maxlength="7" spellcheck="false" autocomplete="off" data-palette-input="contrast" aria-label="Contrast hex colour" />
				</div>
				<div class="variant-swatches" data-variant-swatches="contrast" aria-label="Contrast brightness variants"></div>
			</label>
			<label class="field palette-field">
				<span>Success</span>
				<div class="palette-input-row">
					<input type="color" value="#4E8D57" data-palette-picker="success" aria-label="Success colour picker" />
					<input type="text" value="#4E8D57" maxlength="7" spellcheck="false" autocomplete="off" data-palette-input="success" aria-label="Success hex colour" />
				</div>
				<div class="variant-swatches" data-variant-swatches="success" aria-label="Success brightness variants"></div>
			</label>
			<label class="field palette-field">
				<span>Warning</span>
				<div class="palette-input-row">
					<input type="color" value="#B97A1F" data-palette-picker="warning" aria-label="Warning colour picker" />
					<input type="text" value="#B97A1F" maxlength="7" spellcheck="false" autocomplete="off" data-palette-input="warning" aria-label="Warning hex colour" />
				</div>
				<div class="variant-swatches" data-variant-swatches="warning" aria-label="Warning brightness variants"></div>
			</label>
			<label class="field palette-field">
				<span>Error</span>
				<div class="palette-input-row">
					<input type="color" value="#B44C43" data-palette-picker="error" aria-label="Error colour picker" />
					<input type="text" value="#B44C43" maxlength="7" spellcheck="false" autocomplete="off" data-palette-input="error" aria-label="Error hex colour" />
				</div>
				<div class="variant-swatches" data-variant-swatches="error" aria-label="Error brightness variants"></div>
			</label>
		</div>

		<div class="form-actions">
			<button type="submit" class="button button-primary">Apply palette</button>
			<button type="button" class="button button-secondary" data-theme-palette-reset>Use default palette</button>
		</div>

		<p class="theme-studio-status muted" data-theme-palette-status aria-live="polite">Stored locally in this browser. Light and dark mode reuse the same palette definitions.</p>
	</form>
</section>

@* ── Master tab bar (primary navigation) ── *@
<nav class="master-tabs" role="tablist" aria-label="Content categories">
	@foreach (var cat in Model.Categories)
	{
		var isActive = cat.Key == Model.Category;
		<a class="master-tab @(isActive ? "master-tab-active" : "")"
		   asp-page="/Index"
		   asp-route-category="@cat.Key"
		   role="tab"
		   aria-selected="@(isActive ? "true" : "false")">
		   @cat.Value
		</a>
	}
	<span class="master-tab-separator" aria-hidden="true"></span>
	@foreach (var cat in Model.DataCategories)
	{
		var isActive = cat.Key == Model.Category;
		<a class="master-tab @(isActive ? "master-tab-active" : "")"
		   asp-page="/Index"
		   asp-route-category="@cat.Key"
		   role="tab"
		   aria-selected="@(isActive ? "true" : "false")">
		   @cat.Value
		</a>
	}
</nav>

@if (Model.Category == "objects")
{
	@* ── Master-detail layout for Objects ── *@
	<div class="master-detail-layout">
		@* ── Second master: object type sidebar ── *@
		<aside class="object-type-sidebar">
			<h3 class="sidebar-title">Object Types</h3>
			<ul class="object-type-list">
				<li>
					<a class="object-type-link @(Model.ObjectType == null ? "object-type-link-active" : "")"
					   asp-page="/Index"
					   asp-route-category="objects"
					   asp-route-Search="@Model.Search"
					   asp-route-ObjectSource="@Model.ObjectSource"
					   asp-route-Availability="@Model.Availability">
					   All Types
					</a>
				</li>
				@foreach (var objectType in Model.ObjectTypes)
				{
					var isTypeActive = Model.ObjectType == objectType;
					var isVehicle = objectType == ObjectType.Vehicle;
					<li>
						<a class="object-type-link @(isTypeActive ? "object-type-link-active" : "")"
						   asp-page="/Index"
						   asp-route-category="objects"
						   asp-route-ObjectType="@objectType"
						   asp-route-ObjectSource="@Model.ObjectSource"
						   asp-route-Availability="@Model.Availability"
						   asp-route-Search="@Model.Search">
						   @objectType
						</a>
						@if (isVehicle && isTypeActive)
						{
							<ul class="object-type-sub-list">
								<li>
									<a class="object-type-link @(Model.VehicleType == null ? "object-type-link-active" : "")"
									   asp-page="/Index"
									   asp-route-category="objects"
									   asp-route-ObjectType="@ObjectType.Vehicle"
									   asp-route-ObjectSource="@Model.ObjectSource"
									   asp-route-Availability="@Model.Availability"
									   asp-route-Search="@Model.Search">
									   All Vehicles
									</a>
								</li>
								@foreach (var vt in Model.VehicleTypes)
								{
									var isVtActive = Model.VehicleType == vt;
									<li>
										<a class="object-type-link @(isVtActive ? "object-type-link-active" : "")"
										   asp-page="/Index"
										   asp-route-category="objects"
										   asp-route-ObjectType="@ObjectType.Vehicle"
										   asp-route-VehicleType="@vt"
										   asp-route-ObjectSource="@Model.ObjectSource"
										   asp-route-Availability="@Model.Availability"
										   asp-route-Search="@Model.Search">
										   @vt
										</a>
									</li>
								}
							</ul>
						}
					</li>
				}
			</ul>
		</aside>

		@* ── Detail area ── *@
		<div class="detail-area">
	<section class="panel filter-panel">
			<form method="get" class="filter-form">
				<input type="hidden" name="category" value="objects" />
				<div class="field field-search">
					<label asp-for="Search">Search</label>
					<input asp-for="Search" placeholder="DAT name, internal name, or string-table text" />
				</div>

				<div class="field">
					<label asp-for="ObjectSource">Source</label>
					<select asp-for="ObjectSource">
						<option value="">All sources</option>
						@foreach (var objectSource in Model.ObjectSources)
						{
							<option value="@objectSource">@objectSource</option>
						}
					</select>
				</div>

				<div class="field">
					<label asp-for="Availability">Availability</label>
					<select asp-for="Availability">
						<option value="">Any state</option>
						@foreach (var state in Model.AvailabilityStates)
						{
							<option value="@state">@state</option>
						}
					</select>
				</div>

				<div class="form-actions">
					<button type="submit" class="button button-primary">Apply filters</button>
					<a class="button button-secondary" asp-page="/Index" asp-route-category="objects">Reset</a>
				</div>
			</form>

			<div class="filter-summary stat-grid">
				<div class="stat-card">
					<span>Matching filters</span>
					<strong>@Model.Results.FilteredCount</strong>
				</div>
				<div class="stat-card">
					<span>Current page</span>
					<strong>@Model.Results.Page / @Model.Results.TotalPages</strong>
				</div>
			</div>
		</section>

@if (Model.Results.Items.Count == 0)
{
	<section class="panel empty-state">
		<h2>No objects matched the current query.</h2>
		<p>Try a broader search term or clear one of the filters.</p>
	</section>
}
else
{
	<section class="object-grid">
		@foreach (var item in Model.Results.Items)
		{
			<article class="object-card">
				<div class="card-img-wrap">
					<img class="card-img" src="@item.PreviewImageUrl" loading="lazy" alt="Preview of @item.ResolvedTitle"
					     onerror="this.style.display='none'" />
				</div>
				<div class="card-header">
					<div>
						<p class="eyebrow">@item.ObjectType@if (item.VehicleType != null){<text> / @item.VehicleType</text>}</p>
						<h2>@item.ResolvedTitle</h2>
						<p class="muted">@(item.Description ?? item.InternalName)</p>
					</div>
				</div>

				<dl class="card-meta">
					<div>
						<dt>Source</dt>
						<dd>@item.ObjectSource</dd>
					</div>
					<div>
						<dt>Uploaded</dt>
						<dd>@item.UploadedDate.ToString("yyyy-MM-dd")</dd>
					</div>
					<div>
						<dt>Availability</dt>
						<dd>@item.Availability</dd>
					</div>
					<div>
						<dt>Public file</dt>
						<dd>@(item.CanDownload ? "Available" : "Unavailable")</dd>
					</div>
				</dl>

				<div class="card-actions">
					<a class="button button-primary" asp-page="/Objects/Details" asp-route-id="@item.Id">Inspect</a>
					<a class="button button-secondary" href="@item.ApiUrl">JSON</a>
					@if (item.CanDownload)
					{
						<a class="button button-secondary" href="@item.DownloadUrl">DAT</a>
					}
					else
					{
						<span class="button button-disabled">DAT unavailable</span>
					}
				</div>
			</article>
		}
	</section>

	@if (Model.Results.TotalPages > 1)
	{
		<nav class="pagination">
			@if (Model.Results.HasPreviousPage)
			{
				<a class="button button-secondary"
					   asp-page="/Index"
					   asp-route-category="objects"
					   asp-route-Search="@Model.Search"
					   asp-route-ObjectType="@Model.ObjectType"
					   asp-route-ObjectSource="@Model.ObjectSource"
					   asp-route-Availability="@Model.Availability"
					   asp-route-VehicleType="@Model.VehicleType"
					   asp-route-p="@(Model.Results.Page - 1)">Previous</a>
			}
			else
			{
				<span class="button button-disabled">Previous</span>
			}

			<span class="pagination-label">Page @Model.Results.Page of @Model.Results.TotalPages</span>

			@if (Model.Results.HasNextPage)
			{
				<a class="button button-secondary"
				   asp-page="/Index"
				   asp-route-category="objects"
				   asp-route-Search="@Model.Search"
				   asp-route-ObjectType="@Model.ObjectType"
				   asp-route-ObjectSource="@Model.ObjectSource"
				   asp-route-Availability="@Model.Availability"
				   asp-route-VehicleType="@Model.VehicleType"
				   asp-route-p="@(Model.Results.Page + 1)">Next</a>
			}
			else
			{
				<span class="button button-disabled">Next</span>
			}
		</nav>
	}
}
		</div>
	</div>
}
else if (Model.Category == "scenarios")
{
	<section class="panel empty-state">
		<h2>Scenarios</h2>
		<p>Scenario browsing is coming soon. Scenarios are available through the <a href="/api">API</a>.</p>
	</section>
}
else if (Model.Category == "music")
{
	<section class="panel empty-state">
		<h2>Music</h2>
		<p>Music browsing is coming soon.</p>
	</section>
}
else if (Model.Category == "sfx")
{
	<section class="panel empty-state">
		<h2>Sound Effects</h2>
		<p>Sound effect browsing is coming soon.</p>
	</section>
}
else if (Model.Category == "objectpacks")
{
	<section class="panel">
		<div class="admin-page-header">
			<h1>Object Packs</h1>
		</div>
		@if (!string.IsNullOrEmpty(Model.SuccessMessage) || !string.IsNullOrEmpty(Model.ErrorMessage))
		{
			@if (!string.IsNullOrEmpty(Model.SuccessMessage))
			{<div class="alert alert-success">@Model.SuccessMessage</div>}
			@if (!string.IsNullOrEmpty(Model.ErrorMessage))
			{<div class="alert alert-error">@Model.ErrorMessage</div>}
		}
		@if (Model.ObjectPackList.Count > 0)
		{
			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr>
							<th>Name</th>
							<th>Description</th>
							<th>Uploaded</th>
							<th>Objects</th>
							<th>Authors</th>
							<th>Tags</th>
							<th>Licence</th>
							@if (Model.IsAdmin) { <th class="actions-column">Actions</th> }
						</tr>
					</thead>
					<tbody>
						@foreach (var pack in Model.ObjectPackList)
						{
							<tr>
								<td><strong>@pack.Name</strong></td>
								<td>@(pack.Description.Length > 80 ? pack.Description[..80] + "…" : pack.Description)</td>
								<td>@pack.UploadedDate.ToString("yyyy-MM-dd")</td>
								<td>@pack.ObjectCount</td>
								<td>@pack.AuthorCount</td>
								<td>@pack.TagCount</td>
								<td>@pack.Licence</td>
								@if (Model.IsAdmin)
								{
									<td class="actions-column">
										<form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this pack?')">
											<input type="hidden" name="CrudId" value="@pack.Id" />
											<input type="hidden" name="CrudCategory" value="objectpacks" />
											<button type="submit" class="button button-small button-danger">Delete</button>
										</form>
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<p class="empty-state">No object packs found.</p>
		}
	</section>
}
else if (Model.Category == "sc5files")
{
	<section class="panel">
		<div class="admin-page-header">
			<h1>SC5 Files</h1>
		</div>
		@if (Model.SC5FileList.Count > 0)
		{
			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr>
							<th>Name</th>
							<th>Description</th>
							<th>Uploaded</th>
							<th>Source</th>
							<th>Authors</th>
							<th>Tags</th>
							<th>Licence</th>
							<th>Packs</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var file in Model.SC5FileList)
						{
							<tr>
								<td><a asp-page="/Scenarios/Details" asp-route-id="@file.Id"><strong>@file.Name</strong></a></td>
								<td>@(file.Description.Length > 80 ? file.Description[..80] + "…" : file.Description)</td>
								<td>@file.UploadedDate.ToString("yyyy-MM-dd")</td>
								<td>@file.ObjectSource</td>
								<td>@file.AuthorCount</td>
								<td>@file.TagCount</td>
								<td>@file.Licence</td>
								<td>@file.PackCount</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		else
		{
			<p class="empty-state">No SC5 files found.</p>
		}
	</section>
}

		@if (Model.SC5FilePackList.Count > 0)
		{
			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr>
							<th>Name</th>
							<th>Description</th>
							<th>Uploaded</th>
							<th>Authors</th>
							<th>Tags</th>
							<th>Licence</th>
							<th>Files</th>
							@if (Model.IsAdmin) { <th class="actions-column">Actions</th> }

@page "/Licences/{id}"
@model ObjectService.Pages.Licences.DetailsModel
@{
	ViewData["Title"] = Model.Licence?.Name ?? "Licence";
}

@if (Model.Licence is null)
{
	<section class="panel">
		<h1>Licence not found</h1>
		<p>The licence you are looking for does not exist.</p>
		<a class="button button-secondary" asp-page="/Index" asp-route-category="licences">Back to licence list</a>
	</section>
	return;
}

<section class="detail-hero panel">
	<div>
		<a class="back-link" asp-page="/Index" asp-route-category="licences">Back to licences</a>
		<h1>@Model.Licence.Name</h1>
		@if (!string.IsNullOrWhiteSpace(Model.Licence.Text))
		{
			<div class="note-block">@Model.Licence.Text</div>
		}
	</div>
</section>

<div class="detail-grid-4col">
	<section class="panel">
		<h2>Objects</h2>
		@if (Model.Objects.Count == 0)
		{
			<p class="muted">No objects use this licence.</p>
		}
		else
		{
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Name</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var obj in Model.Objects)
						{
							<tr>
								<td><a asp-page="/Objects/Details" asp-route-id="@obj.Id">@obj.Name</a></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>

	<section class="panel">
		<h2>Object Packs</h2>
		@if (Model.ObjectPacks.Count == 0)
		{
			<p class="muted">No object packs use this licence.</p>
		}
		else
		{
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Name</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var pack in Model.ObjectPacks)
						{
							<tr>
								<td>@pack.Name</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>

	<section class="panel">
		<h2>SC5 Files</h2>
		@if (Model.SC5Files.Count == 0)
		{
			<p class="muted">No SC5 files use this licence.</p>
		}
		else
		{
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Name</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var file in Model.SC5Files)
						{
							<tr>
								<td>@file.Name</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>

	<section class="panel">
		<h2>SC5 File Packs</h2>
		@if (Model.SC5FilePacks.Count == 0)
		{
			<p class="muted">No SC5 file packs use this licence.</p>
		}
		else
		{
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Name</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var pack in Model.SC5FilePacks)
						{
							<tr>
								<td>@pack.Name</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
</div>
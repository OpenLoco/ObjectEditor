@page "/manage/licences/create"
@model ObjectService.Pages.Manage.Licences.CreateModel
@{
	ViewData["Title"] = "Create Licence";
}

<div class="admin-page-container">
	<h1>Create New Licence</h1>

	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="alert alert-error">@Model.ErrorMessage</div>
	}

	<form method="post" class="form">
		<div class="form-group">
			<label asp-for="Name">Licence Name</label>
			<input asp-for="Name" type="text" placeholder="e.g., CC-BY-4.0" required />
		</div>

		<div class="form-group">
			<label asp-for="Text">Licence Text</label>
			<textarea asp-for="Text" placeholder="Enter the full licence text..."></textarea>
		</div>

		<div class="form-actions">
			<button type="submit" class="button button-primary">Create Licence</button>
			<a asp-page="/Manage/Licences/Index" class="button button-secondary">Cancel</a>
		</div>
	</form>
</div>

<link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />

@page "/manage/licences"
@model ObjectService.Pages.Manage.Licences.IndexModel
@{
	ViewData["Title"] = "Manage Licences";
}

<div class="admin-page-container">
	<div class="admin-page-header">
		<h1>Manage Licences</h1>
		<a asp-page="/Manage/Licences/Create" class="button button-primary">+ New Licence</a>
	</div>

	<div class="filter-panel">
		<form method="get" class="filters">
			<div class="filter-group">
				<label for="search">Search</label>
				<input type="text" id="search" name="search" placeholder="Search name or text…" value="@Model.Search" />
			</div>
			<div class="filter-group">
				<button type="submit" class="button button-primary">Filter</button>
				<a href="@Url.Page("/Manage/Licences/Index")" class="button button-secondary">Clear</a>
			</div>
		</form>
	</div>

	@if (!string.IsNullOrEmpty(Model.SuccessMessage))
	{
		<div class="alert alert-success">@Model.SuccessMessage</div>
	}

	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="alert alert-error">@Model.ErrorMessage</div>
	}

	<div class="table-container">
		@if (Model.Licences.Count > 0)
		{
			<table class="data-table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Text (Preview)</th>
						<th class="actions-column">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var licence in Model.Licences)
					{
						<tr>
							<td>@licence.Name</td>
							<td>
								@{
									var preview = licence.Text;
									if (preview?.Length > 100)
									{
										preview = preview.Substring(0, 100) + "...";
									}
								}
								@preview
							</td>
							<td class="actions-column">
								<a asp-page="/Manage/Licences/Edit" asp-route-id="@licence.Id" class="button button-small button-secondary">Edit</a>
								<form method="post" asp-page-handler="Delete" asp-route-id="@licence.Id" style="display: inline;">
									<button type="submit" class="button button-small button-danger" onclick="return confirm('Are you sure you want to delete this licence?');">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		else
		{
			<p class="empty-state">No licences found. <a asp-page="/Manage/Licences/Create">Create one</a>.</p>
		}
	</div>

	<a asp-page="/Manage/Index" class="button button-secondary">Back to Dashboard</a>
</div>

<link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />

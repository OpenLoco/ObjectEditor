@page "/manage/objects/Edit/{id}"
@model ObjectService.Pages.Manage.Objects.EditModel
@{
	ViewData["Title"] = $"Edit Object - {Model.Name}";
}

<div class="admin-page-container">
	<h1>Edit Object: @Model.Name</h1>

	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="alert alert-error">@Model.ErrorMessage</div>
	}

	@if (Model.Object == null)
	{
		<p>Object not found.</p>
	}
	else
	{
		<form method="post" class="form">
			<!-- Basic Information -->
			<fieldset class="form-section">
				<legend>Basic Information</legend>

				<div class="form-group">
					<label for="name">Internal Name</label>
					<input id="name" type="text" asp-for="Name" required />
				</div>

				<div class="form-group">
					<label for="description">Description</label>
					<textarea id="description" asp-for="Description" placeholder="Enter object description..."></textarea>
				</div>

				<div class="form-row">
					<div class="form-group">
						<label for="createdDate">Created Date</label>
						<input id="createdDate" type="date" asp-for="CreatedDate" />
					</div>

					<div class="form-group">
						<label for="modifiedDate">Modified Date</label>
						<input id="modifiedDate" type="date" asp-for="ModifiedDate" />
					</div>

					<div class="form-group">
						<label for="uploadedDate">Uploaded Date</label>
						<input id="uploadedDate" type="date" asp-for="UploadedDate" required />
					</div>
				</div>

				<div class="form-group">
					<label for="availability">Availability</label>
					<select id="availability" asp-for="Availability">
						@foreach (var status in Enum.GetValues<Definitions.ObjectAvailability>())
						{
							<option value="@status">@status</option>
						}
					</select>
				</div>
			</fieldset>

			<!-- Metadata -->
			<fieldset class="form-section">
				<legend>Metadata</legend>

				<div class="form-group">
					<label for="licenceId">Licence</label>
					<select id="licenceId" asp-for="LicenceId">
						<option value="">-- None --</option>
						@foreach (var licence in Model.AvailableLicences)
						{
							<option value="@licence.Id" selected="@(Model.LicenceId == licence.Id)">@licence.Name</option>
						}
					</select>
				</div>

				<div class="form-group">
					<label>Authors</label>
					<div class="multi-select">
						@foreach (var author in Model.AvailableAuthors)
						{
							var isSelected = Model.SelectedAuthorIds.Contains(author.Id);
							<label class="checkbox">
								<input type="checkbox" name="SelectedAuthorIds" value="@author.Id" checked="@isSelected" />
								<span>@author.Name</span>
							</label>
						}
					</div>
				</div>

				<div class="form-group">
					<label>Tags</label>
					<div class="multi-select">
						@foreach (var tag in Model.AvailableTags)
						{
							var isSelected = Model.SelectedTagIds.Contains(tag.Id);
							<label class="checkbox">
								<input type="checkbox" name="SelectedTagIds" value="@tag.Id" checked="@isSelected" />
								<span>@tag.Name</span>
							</label>
						}
					</div>
				</div>

				<div class="form-group">
					<label>Object Packs</label>
					<div class="multi-select">
						@foreach (var pack in Model.AvailableObjectPacks)
						{
							var isSelected = Model.SelectedObjectPackIds.Contains(pack.Id);
							<label class="checkbox">
								<input type="checkbox" name="SelectedObjectPackIds" value="@pack.Id" checked="@isSelected" />
								<span>@pack.Name</span>
							</label>
						}
					</div>
				</div>
			</fieldset>

			<!-- Object Information (Read-only) -->
			<fieldset class="form-section">
				<legend>Object Information (Read-only)</legend>

				<div class="form-row">
					<div class="form-group">
						<label for="objectType">Object Type</label>
						<input id="objectType" type="text" value="@Model.Object.ObjectType" disabled />
					</div>

					<div class="form-group">
						<label for="objectSource">Object Source</label>
						<input id="objectSource" type="text" value="@Model.Object.ObjectSource" disabled />
					</div>

					@if (Model.Object.VehicleType.HasValue)
					{
						<div class="form-group">
							<label for="vehicleType">Vehicle Type</label>
							<input id="vehicleType" type="text" value="@Model.Object.VehicleType" disabled />
						</div>
					}
				</div>

				@if (Model.Object.DatObjects.Count > 0)
				{
					<div class="form-group">
						<label>Associated DAT Objects</label>
						<div class="dat-objects">
							@foreach (var dat in Model.Object.DatObjects)
							{
								<div class="dat-object-item">
									<span>@dat.DatName</span>
									<code>@dat.DatChecksum</code>
								</div>
							}
						</div>
					</div>
				}
			</fieldset>

			<div class="form-actions">
				<button type="submit" class="button button-primary">Save Changes</button>
				<a asp-page="/Manage/Objects/Index" class="button button-secondary">Cancel</a>
			</div>
		</form>
	}
</div>

<link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />
<style>
	.admin-page-container {
		max-width: 900px;
	}
	
	.form {
		overflow: hidden;
	}
	
	.form-actions {
		padding: 2rem;
		border-top: 1px solid var(--color-muted);
		margin-top: 0;
	}
	
	.dat-objects {
		background: var(--color-background);
		border: 1px solid var(--color-muted);
		border-radius: 0.25rem;
		padding: 1rem;
		display: grid;
		gap: 0.75rem;
	}
	
	.dat-object-item {
		padding: 0.75rem;
		background: rgba(255, 255, 255, 0.05);
		border-radius: 0.25rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.9rem;
	}
	
	.dat-object-item code {
		background: rgba(255, 255, 255, 0.1);
		padding: 0.25rem 0.5rem;
		border-radius: 0.2rem;
		font-family: monospace;
		font-size: 0.85rem;
	}
</style>

@page "/manage/objects"
@model ObjectService.Pages.Manage.Objects.IndexModel
@{
	ViewData["Title"] = "Manage Objects";
	var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<div class="admin-page-container">
	<div class="admin-page-header">
		<h1>Manage Objects</h1>
	</div>

	@if (!string.IsNullOrEmpty(Model.SuccessMessage))
	{
		<div class="alert alert-success">@Model.SuccessMessage</div>
	}

	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="alert alert-error">@Model.ErrorMessage</div>
	}

	<div class="filter-panel">
		<form method="get" class="filters">
			<div class="filter-group">
				<label for="search">Search</label>
				<input type="text" id="search" name="search" placeholder="Search by name..." value="@Model.Search" />
			</div>

			<div class="filter-group">
				<label for="objectType">Object Type</label>
				<select id="objectType" name="objectType">
					<option value="">All Types</option>
					@foreach (var type in Model.ObjectTypes)
					{
						<option value="@type" selected="@(Model.ObjectType == type)">@type</option>
					}
				</select>
			</div>

			<div class="filter-group">
				<button type="submit" class="button button-primary">Filter</button>
				<a href="@Url.Page("/Manage/Objects/Index")" class="button button-secondary">Clear</a>
			</div>
		</form>
	</div>

	<div class="table-container">
		<p class="result-count">Total: <strong>@Model.TotalCount</strong> objects</p>

		@if (Model.Objects.Count > 0)
		{
			<table class="data-table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Type</th>
						<th>Uploaded Date</th>
						<th>Authors</th>
						<th>Tags</th>
						<th>Licence</th>
						<th class="actions-column">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var obj in Model.Objects)
					{
						<tr>
							<td><strong>@(string.IsNullOrWhiteSpace(obj.Description) ? obj.Name : obj.Description)</strong></td>
							<td>@obj.ObjectType</td>
							<td>@obj.UploadedDate</td>
							<td>@obj.AuthorCount</td>
							<td>@obj.TagCount</td>
							<td>@obj.Licence</td>
							<td class="actions-column">
								<a asp-page="/Manage/Objects/Edit" asp-route-id="@obj.Id" class="button button-small button-secondary">Edit</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		else
		{
			<p class="empty-state">No objects found matching your criteria.</p>
		}
	</div>

	@if (totalPages > 1)
	{
		<div class="pagination">
			@if (Model.PageNumber > 1)
			{
				<a asp-page="/Manage/Objects/Index" asp-route-p="1" class="button button-small">« First</a>
				<a asp-page="/Manage/Objects/Index" asp-route-p="@(Model.PageNumber - 1)" asp-route-search="@Model.Search" asp-route-objectType="@Model.ObjectType" class="button button-small">‹ Previous</a>
			}

			<span class="page-info">Page @Model.PageNumber of @totalPages</span>

			@if (Model.PageNumber < totalPages)
			{
				<a asp-page="/Manage/Objects/Index" asp-route-p="@(Model.PageNumber + 1)" asp-route-search="@Model.Search" asp-route-objectType="@Model.ObjectType" class="button button-small">Next ›</a>
				<a asp-page="/Manage/Objects/Index" asp-route-p="@totalPages" asp-route-search="@Model.Search" asp-route-objectType="@Model.ObjectType" class="button button-small">Last »</a>
			}
		</div>
	}

	<a asp-page="/Manage/Index" class="button button-secondary">Back to Dashboard</a>
</div>

<link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />

@page "/manage/sc5filepacks"
@model ObjectService.Pages.Manage.SC5FilePacks.IndexModel
@{
	ViewData["Title"] = "Manage SC5 File Packs";
}

<div class="admin-page-container">
	<div class="admin-page-header">
		<h1>Manage SC5 File Packs</h1>
	</div>

	<div class="filter-panel">
		<form method="get" class="filters">
			<div class="filter-group">
				<label for="search">Search</label>
				<input type="text" id="search" name="search" placeholder="Search name or description…" value="@Model.Search" />
			</div>
			<div class="filter-group">
				<button type="submit" class="button button-primary">Filter</button>
				<a href="@Url.Page("/Manage/SC5FilePacks/Index")" class="button button-secondary">Clear</a>
			</div>
		</form>
	</div>

	@if (!string.IsNullOrEmpty(Model.SuccessMessage))
	{
		<div class="alert alert-success">@Model.SuccessMessage</div>
	}

	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="alert alert-error">@Model.ErrorMessage</div>
	}

	<div class="table-container">
		@if (Model.Packs.Count > 0)
		{
			<table class="data-table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Description</th>
						<th>Uploaded Date</th>
						<th>Files</th>
						<th>Authors</th>
						<th>Tags</th>
						<th>Licence</th>
						<th class="actions-column">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var pack in Model.Packs)
					{
						<tr>
							<td><strong>@pack.Name</strong></td>
							<td>
								@{
									var desc = pack.Description;
									if (desc?.Length > 50)
									{
										desc = desc.Substring(0, 50) + "...";
									}
								}
								@desc
							</td>
							<td>@pack.UploadedDate</td>
							<td>@pack.SC5FileCount</td>
							<td>@pack.AuthorCount</td>
							<td>@pack.TagCount</td>
							<td>@pack.Licence</td>
							<td class="actions-column">
								<a asp-page="/Manage/SC5FilePacks/Edit" asp-route-id="@pack.Id" class="button button-small button-secondary">Edit</a>
								<form method="post" asp-page-handler="Delete" asp-route-id="@pack.Id" style="display: inline;">
									<button type="submit" class="button button-small button-danger" onclick="return confirm('Are you sure you want to delete this pack?');">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		else
		{
			<p class="empty-state">No SC5 file packs found.</p>
		}
	</div>

	<a asp-page="/Manage/Index" class="button button-secondary">Back to Dashboard</a>
</div>

<link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />
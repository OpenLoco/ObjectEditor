@page "/manage/tags/create"
@model ObjectService.Pages.Manage.Tags.CreateModel
@{
	ViewData["Title"] = "Create Tag";
}

<div class="admin-page-container">
	<h1>Create New Tag</h1>

	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="alert alert-error">@Model.ErrorMessage</div>
	}

	<form method="post" class="form">
		<div class="form-group">
			<label asp-for="Name">Tag Name</label>
			<input asp-for="Name" type="text" placeholder="Enter tag name" required />
		</div>

		<div class="form-actions">
			<button type="submit" class="button button-primary">Create Tag</button>
			<a asp-page="/Manage/Tags/Index" class="button button-secondary">Cancel</a>
		</div>
	</form>
</div>

<link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />

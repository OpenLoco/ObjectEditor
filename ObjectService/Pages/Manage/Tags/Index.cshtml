@page "/manage/tags"
@model ObjectService.Pages.Manage.Tags.IndexModel
@{
	ViewData["Title"] = "Manage Tags";
}

<div class="admin-page-container">
	<div class="admin-page-header">
		<h1>Manage Tags</h1>
		<a asp-page="/Manage/Tags/Create" class="button button-primary">+ New Tag</a>
	</div>

	<div class="filter-panel">
		<form method="get" class="filters">
			<div class="filter-group">
				<label for="search">Search</label>
				<input type="text" id="search" name="search" placeholder="Search by name…" value="@Model.Search" />
			</div>
			<div class="filter-group">
				<button type="submit" class="button button-primary">Filter</button>
				<a href="@Url.Page("/Manage/Tags/Index")" class="button button-secondary">Clear</a>
			</div>
		</form>
	</div>

	@if (!string.IsNullOrEmpty(Model.SuccessMessage))
	{
		<div class="alert alert-success">@Model.SuccessMessage</div>
	}

	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="alert alert-error">@Model.ErrorMessage</div>
	}

	<div class="table-container">
		@if (Model.Tags.Count > 0)
		{
			<table class="data-table">
				<thead>
					<tr>
						<th>Name</th>
						<th class="actions-column">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var tag in Model.Tags)
					{
						<tr>
							<td>@tag.Name</td>
							<td class="actions-column">
								<a asp-page="/Manage/Tags/Edit" asp-route-id="@tag.Id" class="button button-small button-secondary">Edit</a>
								<form method="post" asp-page-handler="Delete" asp-route-id="@tag.Id" style="display: inline;">
									<button type="submit" class="button button-small button-danger" onclick="return confirm('Are you sure you want to delete this tag?');">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		else
		{
			<p class="empty-state">No tags found. <a asp-page="/Manage/Tags/Create">Create one</a>.</p>
		}
	</div>

	<a asp-page="/Manage/Index" class="button button-secondary">Back to Dashboard</a>
</div>

<link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />

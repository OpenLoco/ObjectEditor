@page "/manage/users"
@model ObjectService.Pages.Manage.Users.IndexModel
@{
	ViewData["Title"] = "Manage Users";
}

<div class="admin-page-container">
	<div class="admin-page-header">
		<h1>Manage Users</h1>
	</div>

	@if (!string.IsNullOrEmpty(Model.SuccessMessage))
	{
		<div class="alert alert-success">@Model.SuccessMessage</div>
	}

	<div class="table-container">
		@if (Model.Users.Count > 0)
		{
			<table class="data-table">
				<thead>
					<tr>
						<th>Username</th>
						<th>Email</th>
						<th>Roles</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var user in Model.Users)
					{
						<tr>
							<td><strong>@user.UserName</strong></td>
							<td>@user.Email</td>
							<td>@(string.IsNullOrEmpty(user.Roles) ? "None" : user.Roles)</td>
						</tr>
					}
				</tbody>
			</table>
		}
		else
		{
			<p class="empty-state">No users found.</p>
		}
	</div>

	<p class="note">User management (create, edit, delete) can be performed via the API or Identity endpoints. This view is for informational purposes only.</p>

	<a asp-page="/Manage/Index" class="button button-secondary">Back to Dashboard</a>
</div>

<style>
.admin-page-container {
	max-width: 1000px;
	margin: 2rem auto;
	padding: 0 1rem;
}

.admin-page-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 2rem;
}

.admin-page-header h1 {
	margin: 0;
}

.alert {
	padding: 1rem;
	margin-bottom: 1rem;
	border-radius: 0.25rem;
}

.alert-success {
	background-color: rgba(78, 141, 87, 0.1);
	color: #4e8d57;
	border: 1px solid rgba(78, 141, 87, 0.3);
}

.table-container {
	background: var(--color-surface);
	border: 1px solid var(--color-muted);
	border-radius: 0.5rem;
	overflow: hidden;
	margin-bottom: 2rem;
}

.data-table {
	width: 100%;
	border-collapse: collapse;
}

.data-table thead {
	background: var(--color-background);
	border-bottom: 2px solid var(--color-muted);
}

.data-table th {
	padding: 1rem;
	text-align: left;
	font-weight: 500;
	color: var(--color-muted);
}

.data-table td {
	padding: 1rem;
	border-bottom: 1px solid var(--color-muted);
}

.data-table tbody tr:hover {
	background-color: rgba(255, 255, 255, 0.02);
}

.empty-state {
	padding: 2rem;
	text-align: center;
	color: var(--color-muted);
	margin: 0;
}

.note {
	background: rgba(246, 201, 69, 0.1);
	border: 1px solid rgba(246, 201, 69, 0.3);
	border-radius: 0.25rem;
	padding: 1rem;
	color: rgba(246, 201, 69, 0.9);
	margin-bottom: 2rem;
	font-size: 0.9rem;
}

.button {
	display: inline-block;
	padding: 0.5rem 1rem;
	background: var(--color-accent);
	color: var(--color-background);
	border: none;
	border-radius: 0.25rem;
	cursor: pointer;
	text-decoration: none;
	font-size: 0.875rem;
	transition: opacity 0.2s;
	font-weight: 500;
}

.button:hover {
	opacity: 0.8;
}

.button-secondary {
	background: transparent;
	color: var(--color-accent);
	border: 1px solid var(--color-accent);
}
</style>

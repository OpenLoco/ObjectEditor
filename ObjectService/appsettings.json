{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:7229"
            },
            "HttpsDefaultCert": {
                "Url": "https://localhost:7230"
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning"
            //"Microsoft.AspNetCore": "Warning",
            //"Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Debug",
            //"Microsoft.EntityFrameworkCore.ChangeTracking": "Information"
        }
    },
    // Secrets (JwtSettings:Key, AdminUser:Password) must never be committed here. Supply them with
    // user-secrets locally (see ObjectService.csproj UserSecretsId and the README) or environment
    // variables when deployed. In Development a missing AdminUser:Password falls back to a generated
    // throwaway password so the Dev Login button works, and a missing JwtSettings:Key falls back to a
    // generated key so the app still starts.
    "JwtSettings": {
        "Issuer": "https://openloco.leftofzen.dev",
        "Audience": "https://openloco.leftofzen.dev",
        "DurationInMinutes": 60
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "SQLiteConnection": "Data Source=Q:\\Games\\Locomotion\\Server\\loco.db"

    },
    "ObjectService": {
        "RootFolder": "Q:\\Games\\Locomotion\\Server",
        "PaletteMapFile": "Q:\\Games\\Locomotion\\Palettes\\palette.png",
        "ShowScalar": true,
        "FrontendReadOnly": false,
        "BackendReadOnly": false,
        "EnableFileWatcher": true,
        // ObjectService:DisableAuthentication is Development-only; set it in appsettings.Development.json.
        // Rendered object images are cached in-memory (bounded by this byte limit) and on disk under
        // GameData/Cache/images (unbounded but regenerable, safe to delete). Defaults to 256 MB if omitted.
        "ImageCache": {
            "MemoryCacheSizeBytes": 268435456
        },
        "RateLimiter": {
            "ReplenishmentPeriod": 1,
            "QueueLimit": 500,
            "TokenLimit": 100,
            "TokensReplenishedPerPeriod": 50,
            "AutoReplenishment": true
        }
    }
}
